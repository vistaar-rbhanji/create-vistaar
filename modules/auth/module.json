{
  "name": "auth",
  "displayName": "Base Auth",
  "version": "2.0.0",
  "description": "Email OTP authentication from modules/base-auth (Express + PostgreSQL).",
  "compatibleWith": ["express"],
  "dependencies": [],
  "enabledWhen": {
    "field": "authentication",
    "equals": "base-auth"
  },
  "npmPackages": {
    "frontend": {
      "dependencies": {
        "axios": "^1.13.6",
        "react-router-dom": "^7.13.1",
        "zod": "^4.3.6"
      }
    }
  },
  "postInstallCommands": [],
  "templateFolders": {},
  "variants": [
    {
      "when": { "uiFramework": "bootstrap" },
      "features": ["Bootstrap VistaarUI adapter"]
    },
    {
      "when": { "uiFramework": "shadcn" },
      "features": ["ShadCN/Tailwind-oriented VistaarUI adapter"]
    },
    {
      "when": { "uiFramework": "material-ui" },
      "features": ["Material UI VistaarUI adapter"]
    }
  ],
  "envExample": {
    "frontend": [
      "VITE_API_BASE_URL={{AUTH_API_URL}}"
    ],
    "root": []
  },
  "summaryTitle": "Installed Base Auth features",
  "features": [
    "Email OTP login / verify / logout / me (from base-auth)",
    "Crypto key-exchange + secure API client",
    "AuthProvider, ProtectedRoute, PublicOnlyRoute",
    "UI adapter matched to selected UI framework",
    "Standalone auth-api service (Express + PostgreSQL + Redis)",
    "init-db.sql and admin seed scripts",
    "Welcome/setup dashboard retained on main backend"
  ]
}
