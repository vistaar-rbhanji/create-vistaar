{
    "name": "create-vistaar",
    "version": "0.1.0",
    "description": "Bootstrap full-stack projects with interactive prompts and reusable templates",
    "author": "Vistaar digital",
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "preferGlobal": true,
    "bin": {
        "create-vistaar": "./dist/index.js"
    },
    "files": [
        "dist",
        "templates",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "npm run clean && tsc",
        "dev": "tsx src/index.ts",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "cli",
        "react",
        "express",
        "fastapi",
        "postgres",
        "mongodb",
        "typescript",
        "javascript",
        "scaffold",
        "starter",
        "boilerplate",
        "project-generator",
        "kickstack"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@inquirer/prompts": "^7.2.0",
        "chalk": "^5.4.1",
        "commander": "^12.1.0",
        "execa": "^9.5.2",
        "fs-extra": "^11.2.0",
        "ora": "^8.1.1"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^22.10.2",
        "rimraf": "^6.1.3",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}
